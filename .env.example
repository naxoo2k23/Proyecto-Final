# =====================================================================
# CONFIGURACIÓN DE CONEXIÓN A POSTGRESQL PARA PLAYMATCH
# Copia este archivo como ".env" en la raíz y pega tu URL de conexión.
# Si no existe ".env" ni variable de entorno, PlayMatch inicia en modo
# respaldo local con SQLite automáticamente.
# =====================================================================

# OPCIÓN 1: URL estándar de la nube (Neon, Supabase, Railway, Render)
# Ejemplo Neon:
# DATABASE_URL=postgresql://usuario:clave@ep-ejemplo-12345.us-east-2.aws.neon.tech/playmatch?sslmode=require
#
# Ejemplo Supabase (Session Pooler):
# DATABASE_URL=postgresql://postgres.proyecto:tu_clave@aws-0-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require

# OPCIÓN 2: PostgreSQL Local o Docker (docker compose up -d)
# DATABASE_URL=jdbc:postgresql://localhost:5432/playmatch
# DB_USER=playmatch
# DB_PASSWORD=playmatch_secret

# =====================================================================
# MOTOR DE RECOMENDACIÓN POR IA (GOOGLE GEMINI API)
# Obtén tu clave gratuita en https://aistudio.google.com/apikey
# Si no se define GEMINI_API_KEY, PlayMatch usa su motor de afinidad local.
# =====================================================================
# GEMINI_API_KEY=tu_api_key_de_gemini_aqui
# GEMINI_MODEL=gemini-3.8-flash

# =====================================================================
# INTEGRACIÓN DISCORD OAUTH2 Y VERIFICACIÓN SMS (OPCIONAL PRODUCCIÓN)
# Si no se configuran, Discord funciona por enlace manual y SMS en modo demo.
# =====================================================================
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# DISCORD_REDIRECT_URI=http://localhost:8080/api/auth/discord/callback
# SMS_PROVIDER=DEMO
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
